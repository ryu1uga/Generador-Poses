{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Electron: app completa",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd"
      },
      "args": [".", "--dev", "--remote-debugging-port=9222"],
      "outputCapture": "std",
      "console": "integratedTerminal"
    },
    {
      "name": "Electron: solo la interfaz (renderer)",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}/src",
      "timeout": 30000
    },
    {
      "name": "Tests (node:test)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": ["--test", "test/**/*.test.mjs"],
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Electron: main + renderer",
      "configurations": ["Electron: app completa", "Electron: solo la interfaz (renderer)"]
    }
  ]
}
